{
  "expo": {
    "name": "smartcart",
    "slug": "smartcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.maduemelie.smartcart",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC1jgqM-Gfss8uXKgmbI9qHH1HLD2ZqV08"
        }
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "955c2fdb-8d7b-46d7-98bf-f764f45bfc45"
      },
      "FIREBASE_API_KEY": "AIzaSyDG0yT0g6gY5Gqh1VdsMjQ5fYb4jgU6cks",
      "FIREBASE_AUTH_DOMAIN": "smart-cart-app-7dbf6.firebaseapp.com",
      "FIREBASE_PROJECT_ID": "smart-cart-app-7dbf6",
      "FIREBASE_STORAGE_BUCKET": "smart-cart-app-7dbf6.firebasestorage.app",
      "FIREBASE_MESSAGING_SENDER_ID": "977281593090",
      "FIREBASE_APP_ID": "1:977281593090:web:9d49e79969ec35331f1c1b",
      "FIREBASE_MEASUREMENT_ID": "G-FY1RPS56R7"
    }
  }
}